{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PublicReadGetObject",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::jewelry-shop-images/products/*"
    },
    {
      "Sid": "DenyAccessToOtherFolders",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:GetObject",
      "Resource": [
        "arn:aws:s3:::jewelry-shop-images/admin/*",
        "arn:aws:s3:::jewelry-shop-images/users/*",
        "arn:aws:s3:::jewelry-shop-images/documents/*"
      ]
    }
  ]
}